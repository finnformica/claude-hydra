#!/usr/bin/env bash
# hydra — many heads, one Claude Code.
#
# Keeps one Claude Code config directory per subscription and routes every
# `claude` launch to the account with the most headroom (5-hour window, weekly
# window, and the Fable weekly window), or to the profile you name.
#
#   hydra add work           create a profile and sign it in
#   hydra status             usage per profile
#   claude                   launch on the freshest profile (via hydra.sh or the shim)
#   claude work --resume     launch on a named profile
#
# State lives in $HYDRA_HOME (default ~/.hydra); nothing secret is written
# there — tokens stay wherever Claude Code keeps them (the macOS Keychain, or
# <config dir>/.credentials.json on Linux).

set -euo pipefail

HYDRA_HOME="${HYDRA_HOME:-$HOME/.hydra}"
HYDRA_MANIFEST="${HYDRA_MANIFEST:-$HYDRA_HOME/profiles.json}"
CACHE_DIR="$HYDRA_HOME/cache"
PROFILES_DIR="$HYDRA_HOME/profiles"
DEFAULT_DIR="$HOME/.claude"
SHIM_DIR="$HYDRA_HOME/bin"          # install.sh --shim links the `claude` shim here
SHIM="$SHIM_DIR/claude"
LOCAL_BIN="${HYDRA_BIN_DIR:-$HOME/.local/bin}"   # where Claude Code's native installer puts `claude`

USAGE_URL="https://api.anthropic.com/api/oauth/usage"
MIN_REFRESH_S=180 # the usage endpoint rate-limits anything faster than this

# Shared between every profile, by symlink into ~/.claude.
SHARED_DIRS="skills plugins projects commands agents"
SHARED_FILES="settings.json CLAUDE.md history.jsonl"

# Claude's own subcommands: never routed unless a profile is named first.
PASSTHROUGH="agents attach auth auto-mode doctor gateway import install logs mcp plugin plugins project respawn rm setup-token stop kill ultrareview update upgrade"
HYDRA_CMDS="add login remove rm rename enable disable list ls names link status refresh pick dir has exec bin doctor help"
RESERVED="auto best $HYDRA_CMDS $PASSTHROUGH"

# ---------------------------------------------------------------- utilities

die() { printf 'hydra: %s\n' "$*" >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }

# The routing hint goes to stderr only when stderr is a terminal: a headless
# caller (`claude -p` from a script) captures stderr for error text and must
# not see it. HYDRA_QUIET=1 always suppresses it, HYDRA_QUIET=0 always prints it.
hint() {
  case "${HYDRA_QUIET:-}" in
    0) ;;
    "") [ -t 2 ] || return 0 ;;
    *) return 0 ;;
  esac
  printf '%s\n' "$*" >&2
}
need() { command -v "$1" >/dev/null 2>&1 || die "needs $1 on PATH"; }

need jq
need curl

darwin() { [ "$(uname -s)" = Darwin ]; }

sha8() {
  if command -v shasum >/dev/null 2>&1; then printf '%s' "$1" | shasum -a 256 | cut -c1-8
  else printf '%s' "$1" | sha256sum | cut -c1-8; fi
}

# ~ in the manifest keeps it portable between machines with different usernames.
expand() { case "$1" in "~") printf '%s' "$HOME" ;; "~/"*) printf '%s%s' "$HOME" "${1#"~"}" ;; *) printf '%s' "$1" ;; esac; }
contract() { case "$1" in "$HOME") printf '~' ;; "$HOME/"*) printf '~%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }
# The same with $HOME, for a path quoted inside a shell command (~ would not expand there).
shell_path() { case "$1" in "$HOME/"*) printf '$HOME%s' "${1#"$HOME"}" ;; *) printf '%s' "$1" ;; esac; }

now() { printf '%s' "${HYDRA_NOW:-$(date +%s)}"; }   # HYDRA_NOW: fixed clock for tests

# The Keychain is used on macOS unless HYDRA_NO_KEYCHAIN is set (tests, or a
# Claude Code install that writes .credentials.json instead).
use_keychain() { darwin && [ -z "${HYDRA_NO_KEYCHAIN:-}" ]; }

# ---------------------------------------------------------------- manifest

EMPTY_MANIFEST='{"version":1,"threshold":90,"weights":{"session":1,"fable":1,"weekly":1},"reset_grace_minutes":10,"default_model":"fable","profiles":{}}'

manifest() { if [ -f "$HYDRA_MANIFEST" ]; then cat "$HYDRA_MANIFEST"; else printf '%s' "$EMPTY_MANIFEST"; fi; }

save_manifest() {
  mkdir -p "$(dirname "$HYDRA_MANIFEST")"
  local tmp="$HYDRA_MANIFEST.tmp.$$"
  jq . >"$tmp" && mv "$tmp" "$HYDRA_MANIFEST"
}

has_profile() { manifest | jq -e --arg n "$1" '.profiles[$n] != null' >/dev/null 2>&1; }
profile_names() { manifest | jq -r '.profiles | keys[]'; }
profile_count() { manifest | jq -r '.profiles | length'; }
profile_dir() { expand "$(manifest | jq -r --arg n "$1" '.profiles[$n].dir')"; }
profile_disabled() { manifest | jq -e --arg n "$1" '.profiles[$n].disabled == true' >/dev/null 2>&1; }
is_default_dir() { [ "$1" = "$DEFAULT_DIR" ]; }

require_profile() { has_profile "$1" || die "no profile named '$1' (hydra list)"; }

valid_name() {
  case "$1" in ''|-*) return 1 ;; esac
  # Under LC_ALL=C on purpose: in a UTF-8 locale bash 3.2 collates [a-z] so it
  # matches capitals too, and `Work` slipped through on macOS (CI caught it).
  [ -z "$(printf '%s' "$1" | LC_ALL=C tr -d 'a-z0-9_-')" ] || return 1
  case " $RESERVED " in *" $1 "*) return 1 ;; esac
  return 0
}

# ---------------------------------------------------------------- credentials

# Claude Code namespaces its Keychain item by the *exact* CLAUDE_CONFIG_DIR
# string it was launched with, so hydra must always export the same string it
# hashes here: the expanded, unresolved path with no trailing slash.
service_name() {
  if is_default_dir "$1"; then printf 'Claude Code-credentials'
  else printf 'Claude Code-credentials-%s' "$(sha8 "$1")"; fi
}

# Prints the credential blob for a config dir; fails when not signed in.
credentials() {
  local dir="$1"
  if use_keychain; then
    security find-generic-password -s "$(service_name "$dir")" -w 2>/dev/null && return 0
  fi
  [ -f "$dir/.credentials.json" ] && cat "$dir/.credentials.json"
}

signed_in() { credentials "$1" >/dev/null 2>&1; }

# Claude keeps the default profile's state file *beside* ~/.claude, not inside it.
claude_json() { if is_default_dir "$1"; then printf '%s/.claude.json' "$HOME"; else printf '%s/.claude.json' "$1"; fi; }

account_email() { jq -r '.oauthAccount.emailAddress // empty' "$(claude_json "$1")" 2>/dev/null || true; }

# Runs the real claude binary inside a profile's config dir.
run_claude() {
  local dir="$1" bin; shift
  bin=$(claude_bin)
  if is_default_dir "$dir"; then "$bin" "$@"
  else CLAUDE_CONFIG_DIR="$dir" "$bin" "$@"; fi
}

# ---------------------------------------------------------------- the real claude

# hydra never runs claude by name: with install.sh --shim, the `claude` on PATH
# *is* hydra, so exec'ing the name would recurse. The real binary is found
# afresh on every launch — the first claude on PATH that is not hydra's shim —
# so that when Claude Code's updater swaps ~/.local/bin/claude for a new
# version, hydra runs the new one without anybody re-running anything.
# HYDRA_CLAUDE_BIN and claude_bin in the manifest are explicit overrides only.

# Follows symlinks without readlink -f (absent on older macOS).
real_path() {
  local p="$1" t
  while [ -L "$p" ]; do
    t=$(readlink "$p")
    case "$t" in /*) p="$t" ;; *) p="$(dirname "$p")/$t" ;; esac
  done
  printf '%s/%s' "$(cd "$(dirname "$p")" && pwd -P)" "$(basename "$p")"
}

# The shim announces itself with a marker in its header; hydra itself counts too.
is_shim() { [ "$1" -ef "$0" ] || { head -c 512 "$1" 2>/dev/null || true; } | grep -q 'hydra-shim'; }   # || true: pipefail must not turn a SIGPIPE into "not a shim"

# Prints the resolved path of a candidate if it is a runnable, non-shim claude.
usable_bin() { [ -n "$1" ] && [ -f "$1" ] && [ -x "$1" ] && ! is_shim "$1" && real_path "$1"; }

find_claude_bin() {
  local IFS=: d c
  for d in $PATH; do
    c="${d:-.}/claude"
    usable_bin "$c" 2>/dev/null && return 0
  done
  return 1
}

manifest_bin() { expand "$(manifest | jq -r '.claude_bin // empty')"; }

CLAUDE_BIN=""
CLAUDE_BIN_FROM=""   # which rule produced it: env, manifest or path (doctor reports it)
claude_bin() {
  if [ -z "$CLAUDE_BIN" ]; then
    local b
    if [ -n "${HYDRA_CLAUDE_BIN:-}" ]; then
      b=$(usable_bin "$(expand "$HYDRA_CLAUDE_BIN")") ||
        die "HYDRA_CLAUDE_BIN=$HYDRA_CLAUDE_BIN is not a runnable claude (missing, not executable, or hydra's own shim)"
      CLAUDE_BIN_FROM=env
    elif b=$(usable_bin "$(manifest_bin)" 2>/dev/null); then
      CLAUDE_BIN_FROM=manifest
    else
      # A manifest entry that no longer runs here (another machine, a pruned
      # version) falls back to PATH rather than blocking every launch.
      b=$(find_claude_bin) ||
        die "no claude binary on PATH apart from hydra's own shim — put Claude Code on PATH, or name it with HYDRA_CLAUDE_BIN (hydra doctor)"
      CLAUDE_BIN_FROM=path
    fi
    CLAUDE_BIN="$b"
  fi
  printf '%s' "$CLAUDE_BIN"
}

# Replaces this process with the real claude, argv[0] "claude" as before.
launch() {
  local bin; bin=$(claude_bin)
  HYDRA_LAUNCH_PID=$$; export HYDRA_LAUNCH_PID   # the shim's recursion tripwire
  exec -a claude "$bin" "$@"
}

# ---------------------------------------------------------------- doctor

# The shim only helps while it shadows the real binary: $HYDRA_HOME/bin has to
# come before wherever `claude` really lives on PATH. Nothing enforces that at
# launch (a launcher that skips the shim never reaches hydra), so `doctor` and
# `status` check it and say so.
shim_installed() { [ -e "$SHIM" ] && is_shim "$SHIM"; }

# hydra.sh exports this when sourced. Without it there is no claude() function
# either, so a shell whose PATH also lacks the shim routes nothing at all — the
# state of a terminal opened before install.sh edited the rc.
rc_sourced() { [ -n "${HYDRA_SOURCED:-}" ]; }
RELOAD_FIX='exec $SHELL, or open a new terminal — this shell predates the lines install.sh added to your rc'

# The first executable called claude on PATH — what a direct launch runs.
first_claude_on_path() {
  local IFS=: d c
  for d in $PATH; do
    c="${d:-.}/claude"
    [ -f "$c" ] && [ -x "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

# Prints the claude a direct launch would run when that is not hydra's shim
# (an empty line when there is none at all); succeeds only in that case.
shim_bypassed_by() {
  local first
  shim_installed || return 1
  first=$(first_claude_on_path) || { printf '\n'; return 0; }
  is_shim "$first" && return 1
  printf '%s\n' "$first"
}

# The layout install.sh --shim used before the shim moved to $HYDRA_HOME/bin:
# the shim *in place of* ~/.local/bin/claude, the original kept beside it.
old_shim_layout() { { [ -e "$LOCAL_BIN/claude" ] && is_shim "$LOCAL_BIN/claude"; } || [ -e "$LOCAL_BIN/claude.hydra-bak" ] || [ -L "$LOCAL_BIN/claude.hydra-bak" ]; }

cmd_doctor() {
  local rc=0 first cand from="" real msg version
  ok()      { printf 'ok    %s\n' "$1"; }
  note()    { printf '      %s\n' "$1"; }
  problem() { rc=1; printf 'FAIL  %s\n      fix: %s\n' "$1" "$2"; }

  # 1. is the shim installed where hydra.sh and the README put it — and only there?
  if shim_installed; then
    ok "shim installed: $(contract "$SHIM") -> $(readlink "$SHIM" 2>/dev/null || printf '(a copy)')"
  elif ! old_shim_layout; then
    problem "shim not installed at $(contract "$SHIM") — launchers that bypass the claude() shell function are not routed" \
            "install.sh --shim"
  fi
  if old_shim_layout; then
    problem "the old shim layout is still in place in $(contract "$LOCAL_BIN") (claude replaced by the shim, or claude.hydra-bak beside it) — Claude Code's updater overwrites it" \
            "install.sh --shim   # migrates it to $(contract "$SHIM_DIR")"
  fi

  # 2. does the shim win a PATH search?
  if shim_installed; then
    if first=$(first_claude_on_path); then
      if [ "$first" -ef "$SHIM" ]; then
        ok "$(contract "$SHIM_DIR") comes first on PATH: a direct \`claude\` runs the shim"
      elif is_shim "$first"; then
        problem "$first (the old shim layout) comes before $(contract "$SHIM_DIR") on PATH" "install.sh --shim"
      else
        case ":$PATH:" in
          *":$SHIM_DIR:"*) msg="$(contract "$SHIM_DIR") is on PATH but after $(dirname "$first")" ;;
          *) msg="$(contract "$SHIM_DIR") is not on PATH" ;;
        esac
        if rc_sourced; then
          problem "$msg: a direct \`claude\` runs $first and skips hydra" \
                  "put it first — exec \$SHELL (hydra.sh does it), or export PATH=\"$(shell_path "$SHIM_DIR"):\$PATH\" in the launcher's environment"
        else
          problem "$msg and hydra.sh is not sourced in this shell: \`claude\` runs $first unrouted, and there is no claude() function to catch it" \
                  "$RELOAD_FIX"
        fi
      fi
    else
      problem "$(contract "$SHIM_DIR") is not on PATH (nor is any claude)" \
              "export PATH=\"$(shell_path "$SHIM_DIR"):\$PATH\" — exec \$SHELL for a shell that sources hydra.sh"
    fi
  else
    if first=$(first_claude_on_path); then
      if rc_sourced; then note "a direct \`claude\` runs $first, unrouted"
      else
        problem "hydra.sh is not sourced in this shell and no shim is installed: \`claude\` runs $first unrouted" \
                "$RELOAD_FIX; install.sh --shim to route launchers that skip the rc too"
      fi
    fi
  fi

  # 3. which real binary hydra would exec right now, and that it is not the shim.
  # (Plain case/if statements, not inside $(...): bash 3.2 cannot parse those.)
  local unpin="hydra bin --unset" how
  if [ -n "${HYDRA_CLAUDE_BIN:-}" ]; then cand=$(expand "$HYDRA_CLAUDE_BIN"); from="HYDRA_CLAUDE_BIN"; unpin="unset HYDRA_CLAUDE_BIN"
  elif cand=$(manifest_bin) && [ -n "$cand" ]; then from="claude_bin in the manifest"; fi
  if [ -n "$from" ] && [ -e "$cand" ] && is_shim "$cand"; then
    problem "$from names hydra's own shim ($cand): every launch would recurse (the shim stops it with exit 70)" "$unpin"
  elif real=$(claude_bin 2>&1); then
    claude_bin >/dev/null   # again, in this shell, so CLAUDE_BIN_FROM is set (it cannot fail twice)
    if is_shim "$real"; then
      problem "the real claude resolves to hydra's own shim ($real): every launch would recurse" \
              "unset HYDRA_CLAUDE_BIN; hydra bin --unset; install.sh --unshim if it persists"
    else
      version=$("$real" --version 2>/dev/null | awk '{print $1}' || true)
      case "$CLAUDE_BIN_FROM" in
        env) how="pinned by HYDRA_CLAUDE_BIN" ;;
        manifest) how="pinned by claude_bin in the manifest" ;;
        *) how="found on PATH" ;;
      esac
      ok "real claude: $real${version:+ ($version)}, $how"
      if [ "$CLAUDE_BIN_FROM" != path ] && first=$(find_claude_bin) && [ "$first" != "$real" ]; then
        note "PATH would give $first instead; the pin does not follow updates ($unpin to follow PATH)"
      fi
      if [ -n "$from" ] && [ "$CLAUDE_BIN_FROM" = path ]; then
        note "$from ($cand) does not run on this machine and is ignored (hydra bin --unset to tidy it)"
      fi
    fi
  else
    if [ -n "${HYDRA_CLAUDE_BIN:-}" ]; then how="unset HYDRA_CLAUDE_BIN, or point it at the real binary"
    else how="install Claude Code and put it on PATH (hydra never runs its own shim)"; fi
    problem "cannot resolve the real claude: ${real#hydra: }" "$how"
  fi

  return "$rc"
}

# ---------------------------------------------------------------- model intent

# "fable" → the Fable weekly window binds; anything else → only the 5-hour and
# all-models weekly windows do. Resolved from --model, then $HYDRA_MODEL, then
# the model in ~/.claude/settings.json, then the manifest's default_model.
model_intent() {
  local m="${1:-}"
  [ -n "$m" ] || m="${HYDRA_MODEL:-}"
  [ -n "$m" ] || m=$(jq -r '.model // empty' "$DEFAULT_DIR/settings.json" 2>/dev/null || true)
  case "$m" in ''|default) m=$(manifest | jq -r '.default_model // "fable"') ;; esac
  printf '%s' "$m" | tr '[:upper:]' '[:lower:]'
}

# Pulls the --model value out of a claude argument list, if any.
model_from_args() {
  local prev=""
  for a in "$@"; do
    case "$a" in
      --model=*) printf '%s' "${a#--model=}"; return ;;
    esac
    [ "$prev" = "--model" ] && { printf '%s' "$a"; return; }
    prev="$a"
  done
}

model_label() { case "$1" in *fable*) printf 'fable' ;; *opus*) printf 'opus' ;; *sonnet*) printf 'sonnet' ;; *haiku*) printf 'haiku' ;; *) printf '%s' "$1" ;; esac; }

# ---------------------------------------------------------------- usage

claude_version() { local b; b=$(claude_bin 2>/dev/null) || return 0; "$b" --version 2>/dev/null | awk '{print $1}'; }

# Fetches /api/oauth/usage for one profile into the cache. Prints a status word.
fetch_usage() {
  local name="$1" dir token code creds
  dir=$(profile_dir "$name")
  creds=$(credentials "$dir") || { printf 'no-auth'; return 0; }
  token=$(printf '%s' "$creds" | jq -r '.claudeAiOauth.accessToken // empty')
  [ -n "$token" ] || { printf 'no-auth'; return 0; }

  mkdir -p "$CACHE_DIR"
  local tmp="$CACHE_DIR/$name.tmp.$$" cache="$CACHE_DIR/$name.json"
  code=$(curl -sS -m 10 -o "$tmp" -w '%{http_code}' "$USAGE_URL" \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "User-Agent: claude-code/${CLAUDE_VERSION:-$(claude_version)}" \
    -H "Content-Type: application/json" 2>/dev/null) || code=000

  case "$code" in
    200)
      if jq -e '.limits | type == "array"' "$tmp" >/dev/null 2>&1; then
        jq --arg at "$(now)" '{
          fetched_at: ($at | tonumber), source: "api", auth: "ok",
          limits: .limits,
          locked: ([.five_hour.locked_reason, .seven_day.locked_reason] | map(select(. != null)))
        }' "$tmp" >"$tmp.2" && mv "$tmp.2" "$cache"   # atomic: a launch may be reading it
        printf 'ok'
      else
        printf 'bad-response'
      fi ;;
    401)
      # The access token has lapsed; Claude refreshes it itself on next launch.
      if [ -f "$cache" ]; then jq '.auth = "stale"' "$cache" >"$tmp.2" && mv "$tmp.2" "$cache"
      else printf '{"fetched_at":0,"source":"api","auth":"stale","limits":[],"locked":[]}' >"$cache"; fi
      printf 'stale' ;;
    429) printf 'rate-limited' ;;
    000) printf 'offline' ;;
    *) printf 'http-%s' "$code" ;;
  esac
  rm -f "$tmp"
}

# jq prelude shared by snapshot/pick/status.
JQ_LIB='
  def ts: if . == null then null
          else (sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | sub("Z?$"; "Z") | fromdateiso8601) end;
  def bucket(f): ([.limits[]? | select(f)] | .[0]) as $b
                 | if $b == null then null
                   else {pct: ($b.percent // 0), resets: ($b.resets_at | ts), severity: $b.severity} end;
  # A window that has already reset (or is about to) counts as empty.
  def eff(b; grace): if b == null then null
                     elif (b.resets != null and b.resets <= $now + grace) then 0
                     else b.pct end;
  # Why a profile is (or is not) usable, first reason wins. The status table and
  # `status --json` both read it from here so the two can never disagree.
  def state($threshold):
    if (.signed_in | not) then "not signed in on this machine"
    elif .disabled then "disabled"
    elif .locked then "locked"
    elif ([.session.pct, .weekly.pct, .fable.pct] | map(. // 0) | max) >= $threshold then "exhausted"
    elif .auth == "stale" then "token stale — refreshes on next launch"
    elif .session == null then "no usage data yet"
    else "ok" end;
'

# One normalised usage record per profile, from whichever is newer: hydra'"'"'s
# own cache or the snapshot Claude Code writes after each session.
snapshot() {
  local name="$1" dir hydra_cache claude_cache signed disabled
  dir=$(profile_dir "$name")
  signed=false; signed_in "$dir" && signed=true
  disabled=false; profile_disabled "$name" && disabled=true
  hydra_cache=$(jq -c . "$CACHE_DIR/$name.json" 2>/dev/null || printf 'null')
  claude_cache=$(jq -c '.cachedUsageUtilization // null
    | if . == null or .utilization == null then null
      else {fetched_at: ((.fetchedAtMs // 0) / 1000 | floor), source: "claude", auth: "ok",
            limits: (.utilization.limits // []),
            locked: ([.utilization.five_hour.locked_reason, .utilization.seven_day.locked_reason] | map(select(. != null)))}
      end' "$(claude_json "$dir")" 2>/dev/null || printf 'null')
  jq -n --arg name "$name" --arg dir "$dir" --argjson signed "$signed" --argjson disabled "$disabled" \
    --argjson h "$hydra_cache" --argjson c "$claude_cache" --arg email "$(account_email "$dir")" "$JQ_LIB"'
    ([$h, $c] | map(select(. != null)) | sort_by(.fetched_at) | last) as $u
    | ($u // {fetched_at: 0, source: null, auth: "unknown", limits: [], locked: []})
    | {
        name: $name, dir: $dir, email: $email, signed_in: $signed, disabled: $disabled,
        fetched_at, source, auth,
        locked: ((.locked // []) | length > 0),
        session: bucket(.kind == "session"),
        weekly:  bucket(.kind == "weekly_all"),
        fable:   bucket(.kind == "weekly_scoped" and ((.scope.model.display_name // "") | ascii_downcase) == "fable")
      }'
}

SNAPSHOTS=""
snapshots() {
  if [ -z "$SNAPSHOTS" ]; then
    local n
    SNAPSHOTS=$(for n in $(profile_names); do snapshot "$n"; done | jq -s .)
  fi
  printf '%s' "$SNAPSHOTS"
}

# Refreshes profiles whose data is older than MIN_REFRESH_S (or all with --force).
refresh() {
  local force=0 names="" n status t age
  while [ $# -gt 0 ]; do
    case "$1" in --force) force=1 ;; --stale) ;; *) names="$names $1" ;; esac; shift
  done
  # Bare `refresh` covers every profile, disabled ones included: it is "fetch
  # usage now", and status shows the disabled rows. Only the launch path narrows
  # to the profiles it could pick, by naming them.
  [ -n "$names" ] || names=$(profile_names | tr '\n' ' ')
  t=$(now)
  CLAUDE_VERSION=$(claude_version); export CLAUDE_VERSION
  for n in $names; do
    require_profile "$n"
    if [ "$force" -eq 0 ]; then
      age=$(( t - $(snapshot "$n" | jq -r '.fetched_at') ))
      [ "$age" -ge "$MIN_REFRESH_S" ] || { printf '%-12s fresh (%ss ago)\n' "$n" "$age"; continue; }
    fi
    status=$(fetch_usage "$n")
    printf '%-12s %s\n' "$n" "$status"
  done
  SNAPSHOTS=""
}

# Ranks enabled, signed-in profiles; prints one JSON object for the winner.
#   Fable session:  score = max(session × w_session, fable × w_fable); ties → weekly
#   other model:    score = max(session × w_session, weekly × w_weekly); Fable ignored
#   ties within 5 points → the soonest 5-hour reset
#   anything at/over the threshold, or locked, is only used when nothing else is
pick_json() {
  local intent; intent=$(model_label "$(model_intent "${1:-}")")
  snapshots | jq -c --argjson cfg "$(manifest)" --argjson now "$(now)" --arg intent "$intent" "$JQ_LIB"'
    ($cfg.threshold // 90) as $threshold
    | (($cfg.reset_grace_minutes // 10) * 60) as $grace
    | ($cfg.weights.session // 1) as $ws
    | ($cfg.weights.fable // 1) as $wf
    | ($cfg.weights.weekly // 1) as $ww
    | ($intent == "fable") as $fable
    | map(select(.signed_in and (.disabled | not)))
    | map(. + {s: eff(.session; $grace), w: eff(.weekly; 0), f: (if $fable then eff(.fable; 0) else null end)})
    | map(. + {known: (.session != null), intent: $intent})
    | map(. + {exhausted: (.locked or (([.s, .w, .f] | map(. // 0) | max) >= $threshold))})
    | map(. + {score: (if $fable then [(.s // 0) * $ws, (.f // 0) * $wf] else [(.s // 0) * $ws, (.w // 0) * $ww] end | max)})
    | (map(select(.exhausted | not)) as $ok | if ($ok | length) > 0 then $ok else . end)
    | sort_by([(if .known then 0 else 1 end), (.score / 5 | floor), (.w // 0), (.session.resets // 0)])
    | .[0] // empty'
}

fmt_pct() { if [ "$1" = "null" ] || [ -z "$1" ]; then printf '   -'; else printf '%3s%%' "$1"; fi; }

fmt_in() { # seconds → "2h13m" / "3d"
  local s="$1"
  if [ "$s" = "null" ] || [ -z "$s" ]; then printf '-'; return; fi
  [ "$s" -gt 0 ] || { printf 'now'; return; }
  if [ "$s" -ge 86400 ]; then printf '%dd%dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else printf '%dm' $((s / 60)); fi
}

# ---------------------------------------------------------------- linking

# A brand-new config dir makes Claude Code run its first-run wizard (theme,
# sign-in) even though the profile is already signed in. Copying the
# onboarding markers from ~/.claude.json skips it. Never overwrites a value
# the profile already has, never touches the default profile.
SEED_KEYS='["hasCompletedOnboarding","lastOnboardingVersion","theme","shiftEnterKeyBindingInstalled","hasIdeOnboardingBeenShown","preferredNotifChannel","editorMode","hasSeenTasksHint"]'
seed_state() {
  local dir="$1" src="$HOME/.claude.json" dst tmp
  is_default_dir "$dir" && return 0
  [ -f "$src" ] || return 0
  dst=$(claude_json "$dir"); tmp="$dst.hydra.$$"
  mkdir -p "$dir"
  [ -f "$dst" ] || printf '{}' >"$dst"
  jq -s --argjson keys "$SEED_KEYS" '
    .[0] as $src | .[1] as $dst
    | $dst + ($src
        | with_entries(select((.key as $k | $keys | index($k)) != null and .value != null))
        | with_entries(select(.key as $k | $dst[$k] == null)))' "$src" "$dst" >"$tmp"     && mv "$tmp" "$dst" && chmod 600 "$dst"
}

# Symlinks the shared parts of ~/.claude into a profile dir. Idempotent.
link_shared() {
  local dir="$1" force="${2:-0}" item src dst
  is_default_dir "$dir" && return 0
  mkdir -p "$dir"
  for item in $SHARED_DIRS $SHARED_FILES; do
    src="$DEFAULT_DIR/$item"; dst="$dir/$item"
    case " $SHARED_DIRS " in *" $item "*) mkdir -p "$src" ;; esac
    [ -e "$src" ] || continue
    if [ -L "$dst" ]; then
      [ "$(readlink "$dst")" = "$src" ] || { rm "$dst"; ln -s "$src" "$dst"; say "  relinked $item"; }
    elif [ -e "$dst" ]; then
      if [ "$force" -eq 1 ]; then
        mv "$dst" "$dst.hydra-bak"; ln -s "$src" "$dst"; say "  replaced $item (old copy at $item.hydra-bak)"
      else
        say "  ! $item is a real file in this profile, not a link to ~/.claude — hydra link --force to replace it"
      fi
    else
      ln -s "$src" "$dst"; say "  linked $item"
    fi
  done
}

# ---------------------------------------------------------------- commands

cmd_add() {
  local name="" dir="" existing=0 login=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --existing|--default) existing=1 ;;
      --dir) shift; dir="$1" ;;
      --no-login) login=0 ;;
      -*) die "unknown option $1" ;;
      *) [ -z "$name" ] && name="$1" || die "unexpected argument $1" ;;
    esac; shift
  done
  [ -n "$name" ] || die "usage: hydra add <name> [--existing | --dir PATH] [--no-login]"
  valid_name "$name" || die "'$name' is not a usable name (lowercase letters, digits, - and _; not a claude subcommand)"
  has_profile "$name" && die "profile '$name' already exists"

  if [ "$existing" -eq 1 ]; then dir="$DEFAULT_DIR"
  elif [ -z "$dir" ]; then dir="$PROFILES_DIR/$name"
  else dir=$(expand "$dir"); dir="${dir%/}"; fi

  manifest | jq --arg n "$name" --arg d "$(contract "$dir")" '.profiles[$n] = {dir: $d}' | save_manifest
  say "added '$name' → $(contract "$dir")"
  link_shared "$dir"
  seed_state "$dir"

  if [ "$login" -eq 1 ] && ! signed_in "$dir"; then cmd_login "$name"
  else record_email "$name"; fi
}

record_email() {
  local name="$1" email
  email=$(account_email "$(profile_dir "$name")")
  [ -n "$email" ] || return 0
  manifest | jq --arg n "$name" --arg e "$email" '.profiles[$n].email = $e' | save_manifest
}

cmd_login() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: hydra login <name>"
  require_profile "$name"
  local dir; dir=$(profile_dir "$name")
  link_shared "$dir"
  seed_state "$dir"
  say "signing in '$name'…"
  run_claude "$dir" auth login
  seed_state "$dir"   # again: the login may have rewritten the state file
  record_email "$name"
  CLAUDE_VERSION=$(claude_version) fetch_usage "$name" >/dev/null || true
  say "signed in '$name' as $(account_email "$dir")"
}

cmd_remove() {
  local name="" keep=0
  while [ $# -gt 0 ]; do
    case "$1" in --keep-files) keep=1 ;; -*) die "unknown option $1" ;; *) name="$1" ;; esac; shift
  done
  [ -n "$name" ] || die "usage: hydra remove <name> [--keep-files]"
  require_profile "$name"
  local dir; dir=$(profile_dir "$name")

  if is_default_dir "$dir"; then
    say "'$name' is your default ~/.claude — forgetting it, leaving the sign-in alone"
  else
    if use_keychain; then security delete-generic-password -s "$(service_name "$dir")" >/dev/null 2>&1 || true; fi
    rm -f "$dir/.credentials.json"
    if [ "$keep" -eq 0 ]; then
      case "$dir" in
        "$PROFILES_DIR"/*) rm -rf "$dir"; say "deleted $(contract "$dir")" ;;
        *) say "left $(contract "$dir") in place (outside $(contract "$PROFILES_DIR"))" ;;
      esac
    fi
  fi
  rm -f "$CACHE_DIR/$name.json"
  manifest | jq --arg n "$name" 'del(.profiles[$n])' | save_manifest
  say "removed '$name'"
}

cmd_rename() {
  local old="${1:-}" new="${2:-}"
  [ -n "$old" ] && [ -n "$new" ] || die "usage: hydra rename <old> <new>"
  require_profile "$old"
  valid_name "$new" || die "'$new' is not a usable name (lowercase letters, digits, - and _; not a subcommand)"
  has_profile "$new" && die "profile '$new' already exists"
  # The config dir (and so the Keychain item) stays put; only the label changes.
  manifest | jq --arg o "$old" --arg n "$new" '.profiles[$n] = .profiles[$o] | del(.profiles[$o])' | save_manifest
  [ -f "$CACHE_DIR/$old.json" ] && mv "$CACHE_DIR/$old.json" "$CACHE_DIR/$new.json"
  say "renamed '$old' → '$new'"
}

cmd_disable() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: hydra disable <name>"
  require_profile "$name"
  manifest | jq --arg n "$name" '.profiles[$n].disabled = true' | save_manifest
  say "'$name' is out of the rotation (claude $name still works)"
}

cmd_enable() {
  local name="${1:-}"; [ -n "$name" ] || die "usage: hydra enable <name>"
  require_profile "$name"
  manifest | jq --arg n "$name" 'del(.profiles[$n].disabled)' | save_manifest
  say "'$name' is back in the rotation"
}

cmd_list() {
  manifest | jq -r '.profiles | to_entries[] | "\(.key)\t\(.value.dir)\t\(.value.email // "")\t\(if .value.disabled then "disabled" else "" end)"' |
    awk -F'\t' '{printf "%-16s %-32s %-30s %s\n", $1, $2, $3, $4}'
}

cmd_link() {
  local force=0 names=""
  while [ $# -gt 0 ]; do case "$1" in --force) force=1 ;; *) names="$names $1" ;; esac; shift; done
  [ -n "$names" ] || names=$(profile_names | tr '\n' ' ')
  local name
  for name in $names; do
    require_profile "$name"
    say "$name:"
    link_shared "$(profile_dir "$name")" "$force"
    seed_state "$(profile_dir "$name")"
  done
}

cmd_status() {
  local cached=0 force=0 json=0
  while [ $# -gt 0 ]; do case "$1" in --cached) cached=1 ;; --force) force=1 ;; --json) json=1 ;; esac; shift; done
  [ "$(profile_count)" -gt 0 ] || die "no profiles yet — hydra add <name>"
  # The one failure mode nothing else reports: the shim is in but a direct
  # `claude` never reaches it. Always to stderr, terminal or not.
  local winner
  if winner=$(shim_bypassed_by); then
    if rc_sourced; then
      say "hydra: warning: the claude shim is installed but ${winner:-nothing} wins a PATH search, so direct launches skip hydra (hydra doctor)"
    else
      say "hydra: warning: hydra.sh is not sourced in this shell and ${winner:-nothing} wins a PATH search, so nothing here is routed — exec \$SHELL (hydra doctor)"
    fi
  fi
  if [ "$cached" -eq 0 ]; then
    if [ "$force" -eq 1 ]; then refresh --force >/dev/null; else refresh --stale >/dev/null; fi
  fi
  local threshold; threshold=$(manifest | jq -r '.threshold // 90')
  if [ "$json" -eq 1 ]; then
    # The table's rows, verbatim, for tools that poll usage (nothing secret is
    # in a snapshot). `now` lets callers count down to a reset without clock skew.
    snapshots | jq --argjson now "$(now)" --argjson threshold "$threshold" "$JQ_LIB"'
      {threshold: $threshold, now: $now, profiles: map(. + {state: state($threshold)})}'
    return 0
  fi
  printf '%-16s %-30s %5s %5s %6s  %-8s %-6s %s\n' PROFILE ACCOUNT 5H WEEK FABLE '5H-RESET' AGE STATE
  snapshots | jq -r --argjson now "$(now)" --argjson threshold "$threshold" "$JQ_LIB"'
    .[] | [
      .name, (if (.email // "") == "" then "-" else .email end),
      (.session.pct // "null"), (.weekly.pct // "null"), (.fable.pct // "null"),
      (if .session.resets then (.session.resets - $now) else "null" end),
      (if .fetched_at > 0 then ($now - .fetched_at) else "null" end),
      state($threshold)
    ] | map(tostring) | join("|")' |
  while IFS='|' read -r name email s w f resets age state; do
    printf '%-16s %-30s %5s %5s %6s  %-8s %-6s %s\n' \
      "$name" "$email" "$(fmt_pct "$s")" "$(fmt_pct "$w")" "$(fmt_pct "$f")" \
      "$(fmt_in "$resets")" "$(fmt_in "$age")" "$state"
  done
}

cmd_pick() {
  local json=0 model=""
  while [ $# -gt 0 ]; do
    case "$1" in --json) json=1 ;; --model) shift; model="${1:-}" ;; --model=*) model="${1#--model=}" ;; *) die "usage: hydra pick [--json] [--model M]" ;; esac; shift
  done
  [ "$(profile_count)" -gt 0 ] || die "no profiles yet — hydra add <name>"
  ensure_usage
  local p; p=$(pick_json "$model") || true
  [ -n "$p" ] || die "no signed-in profile on this machine"
  if [ "$json" -eq 1 ]; then printf '%s\n' "$p"; else printf '%s\n' "$p" | jq -r .name; fi
}

# First launch after sign-in: fetch synchronously for any signed-in profile
# with no data at all, so the pick is never blind.
ensure_usage() {
  local missing
  missing=$(snapshots | jq -r '.[] | select(.signed_in and (.disabled | not) and .fetched_at == 0) | .name')
  [ -n "$missing" ] && refresh --force $missing >/dev/null 2>&1 || true
}

# Kicks off a refresh of stale profiles without holding up the launch.
background_refresh() {
  local stale
  stale=$(snapshots | jq -r --argjson now "$(now)" --argjson min "$MIN_REFRESH_S" \
    '.[] | select(.signed_in and (.disabled | not) and ($now - .fetched_at) >= $min) | .name' | tr '\n' ' ')
  [ -n "${stale// /}" ] || return 0
  ( "$0" refresh --force $stale >/dev/null 2>&1 & ) >/dev/null 2>&1
}

cmd_exec() {
  # An explicit CLAUDE_CONFIG_DIR is the caller's decision; don't second-guess it.
  if [ -n "${CLAUDE_CONFIG_DIR:-}" ] || [ "$(profile_count)" -eq 0 ]; then launch "$@"; fi

  local name=""
  if [ $# -gt 0 ]; then
    if has_profile "$1"; then name="$1"; shift
    else
      case " $PASSTHROUGH " in *" $1 "*) launch "$@" ;; esac
      case "$1" in --version|-v|--help|-h) launch "$@" ;; esac
    fi
  fi

  if [ -z "$name" ]; then
    ensure_usage
    local p; p=$(pick_json "$(model_from_args "$@")") || true
    if [ -z "$p" ]; then
      hint "hydra: no signed-in profile on this machine — launching with default config"
      launch "$@"
    fi
    name=$(printf '%s' "$p" | jq -r .name)
    hint "$(printf '%s' "$p" | jq -r '"hydra → \(.name)   5h \(.s // "-")%   week \(.w // "-")%\(if .intent == "fable" then "   Fable \(.f // "-")%" else "   (\(.intent): Fable window ignored)" end)\(if .exhausted then "   (everything is near its limit)" else "" end)"')"
  fi

  background_refresh
  local dir; dir=$(profile_dir "$name")
  if is_default_dir "$dir"; then launch "$@"
  else export CLAUDE_CONFIG_DIR="$dir"; launch "$@"; fi
}

# hydra bin            the real claude hydra execs right now (resolved)
# hydra bin PATH       pin one in the manifest — an override; it will not follow updates
# hydra bin --unset    drop the pin; PATH is walked on every launch again (the default)
cmd_bin() {
  case "${1:-}" in
    "") claude_bin; echo ;;
    --unset)
      if manifest | jq -e '.claude_bin != null' >/dev/null 2>&1; then
        manifest | jq 'del(.claude_bin)' | save_manifest
        say "claude_bin cleared — hydra runs the first claude on PATH that is not its shim"
      else
        say "claude_bin is not set — hydra already runs the first claude on PATH that is not its shim"
      fi ;;
    -*) die "usage: hydra bin [PATH | --unset]" ;;
    *)
      local real
      real=$(usable_bin "$(expand "$1")") || die "'$1' is not a runnable claude (missing, not executable, or hydra's own shim)"
      manifest | jq --arg b "$(contract "$real")" '.claude_bin = $b' | save_manifest
      say "claude_bin → $(contract "$real") (pinned: it will not follow Claude Code updates; hydra bin --unset to follow PATH)" ;;
  esac
}

cmd_help() {
  cat <<'EOF'
hydra — many heads, one Claude Code

  hydra add <name> [--existing | --dir PATH] [--no-login]
                              new profile (--existing registers ~/.claude itself)
  hydra login <name>          sign in / re-authenticate a profile
  hydra remove <name> [--keep-files]
  hydra rename <old> <new>    relabel a profile (its sign-in is untouched)
  hydra disable <name>        keep it signed in but out of the rotation
  hydra enable <name>         put it back
  hydra list                  profiles and their config dirs
  hydra status [--cached|--force] [--json]
                              usage per profile (refreshes anything older than 3 min);
                              --json prints the same rows as one JSON document
  hydra refresh [names…] [--force]
  hydra pick [--json] [--model M]
                              which profile a bare `claude` (or `claude --model M`) would use
  hydra link [names…] [--force]
                              (re)apply the shared-config symlinks
  hydra dir <name>            print a profile's config dir
  hydra has <name>            exit 0 if the profile exists
  hydra exec [profile] [claude args…]
                              what the `claude` shell function and the shim call
  hydra <profile> [claude args…]
                              shorthand for hydra exec <profile> …
  hydra bin [PATH | --unset]  the real claude binary hydra execs (found on PATH at every
                              launch); pin one, or drop the pin
  hydra doctor                check the shim: installed, first on PATH, and what it runs

Environment: HYDRA_HOME (~/.hydra), HYDRA_MANIFEST, HYDRA_CLAUDE_BIN (pin the real binary),
             HYDRA_QUIET=1 (never print the routing hint; default: only on a terminal;
             HYDRA_QUIET=0 always), HYDRA_MODEL (score for this model when no --model is passed)
EOF
}

case "${1:-help}" in
  add)     shift; cmd_add "$@" ;;
  login)   shift; cmd_login "$@" ;;
  remove|rm) shift; cmd_remove "$@" ;;
  rename)  shift; cmd_rename "$@" ;;
  enable)  shift; cmd_enable "$@" ;;
  disable) shift; cmd_disable "$@" ;;
  list|ls) cmd_list ;;
  names)   profile_names ;;
  link)    shift; cmd_link "$@" ;;
  status)  shift; cmd_status "$@" ;;
  refresh) shift; refresh "$@" ;;
  pick)    shift; cmd_pick "$@" ;;
  dir)     require_profile "${2:-}"; profile_dir "$2"; echo ;;
  has)     has_profile "${2:-}" ;;
  exec)    shift; cmd_exec "$@" ;;
  bin)     shift; cmd_bin "$@" ;;
  doctor)  cmd_doctor ;;
  help|-h|--help) cmd_help ;;
  *) if has_profile "$1"; then cmd_exec "$@"; else die "unknown command '$1' (hydra help)"; fi ;;
esac
